{
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:@marimo-team/*"]
  },
  "unstable": ["sloppy-imports"],
  "imports": {
    "@marimo-team/mdx-marimo/bridge/element": "npm:@marimo-team/mdx-marimo@0.0.5/bridge/element",
    "@marimo-team/mdx-marimo/bridge/protocol": "npm:@marimo-team/mdx-marimo@0.0.5/bridge/protocol",
    "@marimo-team/mdx-marimo/styles.css": "npm:@marimo-team/mdx-marimo@0.0.5/styles.css",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@quarto/types": "./types/quarto-types.d.ts",
    "linkedom": "npm:linkedom@0.18.12",
    "path": "jsr:@std/path@1.0.8"
  },
  "bundle": {
    "entryPoint": "src/engine/index.ts",
    "outputFile": "dist/marimo-engine.js"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run tests"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns", "es2022"],
    "strict": true
  }
}
